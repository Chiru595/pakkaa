# Pakkaa environment template.
# Copy to .env and fill in. Never commit .env. On Vercel, add each variable under
# Project > Settings > Environment Variables (Production and Preview).
#
# Legend: [REQUIRED]  needed for the app to start
#         [GENERATED] a random secret; run `python scripts/gen_secrets.py` or let the setup fill it
#         [OPTIONAL]  leave empty to use the safe fallback named on that line

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development                      # development | preview | production
APP_NAME=Pakkaa
WEB_BASE_URL=http://localhost:5173       # [REQUIRED] where the web app is served (used in guest links)
API_BASE_URL=http://localhost:8000       # [REQUIRED] public API URL (used for payment webhooks/callbacks)
CORS_ORIGINS=http://localhost:5173       # [REQUIRED] comma-separated exact origins; no wildcards in production
LOG_LEVEL=INFO
DEMO_MODE=false                          # true shows the scripted demo controls

# ---------------------------------------------------------------------------
# Security (server only)
# ---------------------------------------------------------------------------
JWT_SECRET=                              # [GENERATED] signs access tokens (64+ random chars)
JWT_ACCESS_TTL_SECONDS=900               # 15 minutes
REFRESH_TTL_DAYS=14
GUEST_LINK_SECRET=                       # [GENERATED] signs single-use guest invite links
GUEST_LINK_TTL_HOURS=72
OTP_PEPPER=                              # [GENERATED] OTP codes are stored as HMAC(pepper, code), never plain
FIELD_ENCRYPTION_KEYS=                   # [GENERATED] "v1:<base64 32 bytes>"; comma-separate to rotate (newest first)
CRON_SECRET=                             # [GENERATED] Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"

# ---------------------------------------------------------------------------
# Database: Postgres 16 + pgvector
# Local: docker-compose gives the values below.
# Vercel: add Neon from the Vercel Marketplace (Storage tab); it injects DATABASE_URL and
# DATABASE_URL_UNPOOLED. Run `CREATE EXTENSION vector;` once (the first migration does this).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://pakkaa:pakkaa@localhost:5432/pakkaa            # [REQUIRED] pooled, used by the app
DATABASE_URL_UNPOOLED=postgresql+psycopg://pakkaa:pakkaa@localhost:5432/pakkaa   # [REQUIRED] direct, used by Alembic

# ---------------------------------------------------------------------------
# Nexconn Chat + Call (console: https://console.nexconn.ai > Key Management)
# ---------------------------------------------------------------------------
NEXCONN_APP_KEY=                         # [REQUIRED] public app id (also copied to VITE_NEXCONN_APP_KEY)
NEXCONN_APP_SECRET=                      # [REQUIRED] SERVER ONLY. Signs server API calls and verifies webhooks
NEXCONN_AREA=SG                          # data center shown in Key Management: SG | NA | SA | OM | BJ
NEXCONN_API_BASE_URL=https://api.sg-light-api.com      # must match NEXCONN_AREA (NA: api.us-light-api.com)
NEXCONN_API_BACKUP_URL=https://api-b.sg-light-api.com  # failover after a 5 s timeout, per Nexconn docs
NEXCONN_TOKEN_TTL_SECONDS=86400          # we expire user tokens ourselves; Nexconn's default is "never"
NEXCONN_BOT_USER_ID=pakkaa-bot           # system user that posts cards (Scribe, Warden, Ledger)

# ---------------------------------------------------------------------------
# Browser-safe values (Vite exposes ONLY variables starting with VITE_). Never put a secret here.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_NEXCONN_APP_KEY=                    # same value as NEXCONN_APP_KEY
VITE_NEXCONN_AREA=SG                     # same value as NEXCONN_AREA

# ---------------------------------------------------------------------------
# OpenAI (https://platform.openai.com/api-keys). Models per job; change any without code changes.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=                          # [REQUIRED for AI features] without it, AI panels show "AI offline"; money flows still work
OPENAI_ORG_ID=                           # [OPTIONAL]
OPENAI_PROJECT_ID=                       # [OPTIONAL]
# Fast lane: pre-send check, money-talk detector, intent classification (needs low latency)
LLM_MODEL_FAST=gpt-6-luna
# Live lane: copilot reply options streamed while people negotiate (target under 3 s)
LLM_MODEL_LIVE=gpt-6.1-terra
# Smart lane: Scribe term extraction, card builder, approver brief, clause explainer, lock review, Ask Pakkaa
LLM_MODEL_SMART=gpt-6.2-sol
# Deep lane: chase-or-wait debate, dispute pack, anything slow and high-stakes
LLM_MODEL_DEEP=gpt-6.2-astra
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536
LLM_TRANSCRIBE_MODEL=gpt-transcribe      # call captions fallback; the browser Web Speech API is tried first
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Payments. PAYMENT_PROVIDER=auto picks Paytm if its keys are set, else Razorpay, else Mock.
# Mock and sandbox payments are labelled "Test mode" in the UI.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=auto                    # auto | paytm | razorpay | mock
# Paytm for Business dashboard > Developer Settings > API Keys (Test mode)
PAYTM_ENV=staging                        # staging | production
PAYTM_MID=                               # [OPTIONAL] merchant id
PAYTM_MERCHANT_KEY=                      # [OPTIONAL] SERVER ONLY. Signs requests, verifies callbacks
PAYTM_WEBSITE=WEBSTAGING                 # DEFAULT in production
PAYTM_PAYOUT_SUBWALLET_GUID=             # [OPTIONAL] Paytm Payouts; empty means payouts use Mock
# Razorpay dashboard (Test mode) > Account & Settings > API Keys / Webhooks
RAZORPAY_KEY_ID=                         # [OPTIONAL]
RAZORPAY_KEY_SECRET=                     # [OPTIONAL] SERVER ONLY
RAZORPAY_WEBHOOK_SECRET=                 # [OPTIONAL] SERVER ONLY. Verifies webhook signatures
RAZORPAYX_ACCOUNT_NUMBER=                # [OPTIONAL] RazorpayX payouts; empty means payouts use Mock

# ---------------------------------------------------------------------------
# OTP. mock prints codes to the server log (development and demo only; refused when APP_ENV=production).
# ---------------------------------------------------------------------------
OTP_PROVIDER=mock                        # mock | msg91
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
MSG91_AUTH_KEY=                          # [OPTIONAL] real SMS in India needs a DLT-registered template
MSG91_TEMPLATE_ID=                       # [OPTIONAL]

# ---------------------------------------------------------------------------
# Rate limiting and monitoring
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=                  # [OPTIONAL] shared rate limits across Vercel instances; empty = Postgres-backed limiter
UPSTASH_REDIS_REST_TOKEN=                # [OPTIONAL]
SENTRY_DSN=                              # [OPTIONAL] error tracking
